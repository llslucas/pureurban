# Base URL da API. Lida por src/utils/constants.ts; quando ausente, o fallback é
# http://10.0.2.2:3000 em __DEV__ (alias do host no emulador Android).
#
# ATENCAO — este valor NAO serve para todos os alvos. Escolha o do seu ambiente:
#   alvo web (browser)      → http://localhost:3000
#   emulador Android        → deixe COMENTADO (o fallback 10.0.2.2 é o certo;
#                             localhost, dentro do emulador, é o próprio emulador)
#                             Alternativa: com `adb reverse tcp:3000 tcp:3000` ativo,
#                             http://localhost:3000 também funciona no emulador —
#                             o reverse manda o localhost dele para o host
#                             (ver README, seção "Development build Android")
#   simulador iOS           → http://localhost:3000
#   dispositivo físico      → http://<IP-da-máquina-na-LAN>:3000
#
# Isto NAO tem relação com CORS. O que a API libera é a origem do DOCUMENTO
# (http://localhost:8081, o dev server do Expo), configurada em CORS_ORIGIN na API
# — ver api/.env.example. Erro de CORS no browser se corrige lá, não aqui.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Mocks MSW (Story 3.0 — contrato de embarque digital).
# '1' liga; qualquer outro valor (ou ausente) desliga. Só tem efeito em __DEV__.
#
# Com a flag ligada, POST /api/v1/boarding/check-in e GET /api/v1/trips/:id/students
# são atendidos em memória, sem backend de pé. É como as trilhas mobile do Épico 3
# (3.2b, 3.3b, 3.5b) rodam em paralelo à implementação do backend.
#
# IDs conhecidos pelo mock (ver src/mocks/handlers/boarding.handlers.ts):
#   viagem ativa   → 770e8400-e29b-41d4-a716-446655440100
#   viagem inativa → 770e8400-e29b-41d4-a716-446655440101  (dispara TRIP_NOT_ACTIVE)
#   roster vazio   → 770e8400-e29b-41d4-a716-446655440103  (lista de alunos: estado "sem alunos")
#   roster grande  → 770e8400-e29b-41d4-a716-446655440104  (lista de alunos: 60 alunos, NFR4)
#   roster com erro→ 770e8400-e29b-41d4-a716-446655440105  (GET /trips/:id/students → 500 sempre)
#   roster instável→ 770e8400-e29b-41d4-a716-446655440106  (200 na 1a leitura, 500 nas seguintes: erro COM cache)
#   qualquer outro id de viagem → 404 TRIP_NOT_FOUND
# Alunos do roster: ...440010 / ...440011 / ...440012 (e ...440013 como NOT_RETURNING).
# Um studentId fora do roster dispara 403 STUDENT_NOT_ALLOWED; repetir um check-in
# com key nova dispara 409 DUPLICATE_CHECK_IN.
#
# Login mockado (ver src/mocks/handlers/auth.handlers.ts) — qualquer senha é aceita:
#   aluno@pureurban.com     → STUDENT, studentId 660e8400-e29b-41d4-a716-446655440010 (Ana Souza, do roster acima)
#   motorista@pureurban.com → DRIVER (viagem ativa, check-in aceito)
#   qualquer outro e-mail → 401 INVALID_CREDENTIALS
#
# Sentinelas de estado da tela de scan do motorista (todos DRIVER, senha livre):
#   motorista-sem-viagem@pureurban.com        → GET /trips/active devolve null ("Nenhuma viagem ativa")
#   motorista-outra-viagem@pureurban.com      → viagem ...440102 → check-in 403 DRIVER_NOT_ASSIGNED
#   motorista-viagem-encerrada@pureurban.com  → viagem ...440101 → check-in 409 TRIP_NOT_ACTIVE
#
# Sentinelas da lista de alunos do motorista (Story 3.5b; todos DRIVER, viagem ATIVA, senha livre):
#   motorista-turma-vazia@pureurban.com       → roster vazio (lista mostra "Nenhum aluno vinculado", 0/0)
#   motorista-turma-grande@pureurban.com      → roster de 60 alunos com os 3 status (NFR4)
#   motorista-lista-erro@pureurban.com        → GET /trips/:id/students → 500 sempre (estado 6: erro sem cache)
#   motorista-lista-instavel@pureurban.com    → 200 na 1a leitura, 500 depois (estado 7: erro com a lista em cache + Banner)
#
# Sentinelas de estado da tela de QR do aluno (todos STUDENT, senha livre):
#   aluno-sem-rota@pureurban.com        → GET /routes/mine devolve [] (estado "Nenhuma rota vinculada")
#   aluno-erro@pureurban.com            → GET /routes/mine devolve 500 (estado de erro + snackbar)
#   aluno-multirota@pureurban.com       → GET /routes/mine devolve 2 rotas (badge "+1 rotas")
#   aluno-sessao-expirada@pureurban.com → POST /auth/refresh sempre 401 (exercita o logout forçado)
EXPO_PUBLIC_USE_MOCKS=0

# Hook de injeção de scan para o E2E do Épico 3 (Story 3.6). SÓ TESTES.
# '1' habilita, sob `__DEV__`, um `globalThis.__E2E_INJECT_SCAN__(raw)` na tela
# de scan do motorista, que entrega uma string de QR direto ao handler — o E2E
# roda no web sem câmera. Qualquer outro valor (ou ausente) mantém o efeito nulo.
# NUNCA defina em produção: `EXPO_PUBLIC_*` entra no bundle em build time.
# O projeto `e2e` do Playwright (api/playwright.config.ts) já injeta esta env.
# EXPO_PUBLIC_E2E=0
