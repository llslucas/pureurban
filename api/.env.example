# Test Environment
TEST_ENV=local
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000

# Database (Docker Compose)
POSTGRES_USER=pureurban
POSTGRES_PASSWORD=pureurban_dev
POSTGRES_DB=pureurban
DATABASE_URL=postgresql://pureurban:pureurban_dev@localhost:5432/pureurban

# Auth (for test user seeding)
TEST_USER_EMAIL=admin@pureurban.test
TEST_USER_PASSWORD=test123456

# JWT Auth
JWT_SECRET= # generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS (Story 1.6 — alvo web do app mobile)
# Lista de origens separadas por vírgula, lida por src/main.ts. Quando ausente ou
# vazia, o default é http://localhost:8081 (a porta que `npm run web` fixa no mobile).
# Em produção esta variável é OBRIGATÓRIA: sem ela a API anuncia
# Access-Control-Allow-Origin: http://localhost:8081 e bloqueia o cliente web real.
CORS_ORIGIN=http://localhost:8081
